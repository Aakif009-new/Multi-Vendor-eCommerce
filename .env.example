# ==========================================
# MULTI-VENDOR MARKETPLACE - MONOREPO ENVIRONMENT VARIABLES
# ==========================================
# Note: For security and modular configuration, split environment setups:
# - Place backend parameters in: apps/api/.env
# - Place frontend client parameters in: apps/web/.env
# 
# This file serves as a reference index.
# Do not place credentials in this root file directly.

# ==========================================
# BACKEND KEYS REQUIRED (apps/api/.env)
# ==========================================
# PORT=
# DATABASE_URL=
# JWT_SECRET=
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# PEXELS_API_KEY=

# ==========================================
# FRONTEND KEYS REQUIRED (apps/web/.env)
# ==========================================
# NEXT_PUBLIC_API_URL=
# NEXT_PUBLIC_RAZORPAY_KEY_ID=
