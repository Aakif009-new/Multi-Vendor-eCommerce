# ==============================================================================
# BAZAARONE MULTI-VENDOR MARKETPLACE — PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================
# Architecture:
#   - Frontend: Vercel (Next.js 14 App Router)
#   - Backend: Railway / Render (Express.js Node.js REST API)
#   - Database: MongoDB Atlas (via Prisma ORM)
#   - Storage: Cloudinary
#   - Payments: Razorpay Test Mode
# ==============================================================================

# ==============================================================================
# 1. BACKEND-ONLY PRODUCTION SECRETS (Configure in Railway / Render Dashboard)
# ==============================================================================
NODE_ENV=production
PORT=5000

# MongoDB Atlas Connection String with Replica Set & Retry Writes
DATABASE_URL="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority"

# JWT Authentication & Cookie Encryption Secrets
JWT_SECRET="your_secure_random_jwt_secret_min_32_chars_long"
JWT_EXPIRES_IN="7d"
COOKIE_SECRET="your_secure_random_cookie_signing_secret_min_32_chars"

# Allowed Frontend Origins for CORS (Comma-separated for multiple domains)
CORS_ORIGIN="https://bazaarone.vercel.app,https://your-custom-domain.com"

# Cloudinary Image Management (Vendor Product Assets)
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# Pexels API Key (Used strictly for one-time catalog seeding/import)
PEXELS_API_KEY="your_pexels_api_key"

# Razorpay Test Mode Gateway Credentials
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# ==============================================================================
# 2. FRONTEND PUBLIC ENVIRONMENT VARIABLES (Configure in Vercel Dashboard)
# ==============================================================================
# Next.js Public Client Variables (Safe for Browser Exposure)
NEXT_PUBLIC_API_URL="/api"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_your_key_id"

# Next.js Server-Side API Proxy Rewrite (Targeting Railway/Render Express API)
BACKEND_INTERNAL_URL="https://your-backend-api.up.railway.app"
# Or on Render:
# BACKEND_INTERNAL_URL="https://bazaarone-api.onrender.com"
